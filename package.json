{
  "name": "ravelinjs",
  "version": "2.2.0",
  "license": "Apache-2.0",
  "description": "Ravelin's Browser SDK",
  "author": "Ravelin (https://github.com/unravelin) <support@ravelin.com>",
  "homepage": "https://developer.ravelin.com/libraries-and-sdks/ravelinjs/",
  "bugs": {
    "url": "https://github.com/unravelin/ravelinjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unravelin/ravelinjs.git"
  },
  "scripts": {
    "clean": "rm -rf build dist releases; mkdir build",
    "build": "npm run ts:check && rollup --config",
    "build:watch": "npm run ts:check -- --watch & rollup --config --watch --no-watch.clearScreen",
    "postbuild": "rm -rf ./dist/types && replace-in-file 'import {' 'import type {' ./dist/*.d.ts",
    "dist": "cp README.md LICENSE .npmignore dist",
    "release": "run-s release:copy release:integrity release:integrity:verify release:tarball",
    "release:copy": "mkdir -p releases/ravelinjs-$npm_package_version; set -x; cd build; for f in *.js*; do cp -- $f ../releases/ravelinjs-$npm_package_version/`echo $f | sed s/^ravelin-/ravelin-$npm_package_version-/`; done",
    "release:integrity": "cd releases/ravelinjs-$npm_package_version; shasum -a 384 *.js | sed s/^/sha384-/ > integrity",
    "release:integrity:verify": "cd releases/ravelinjs-$npm_package_version; sed s/^sha384-// integrity | shasum -c",
    "release:tarball": "cd releases; tar -czf ravelinjs-$npm_package_version.tar.gz ravelinjs-$npm_package_version",
    "lint:ts": "eslint -f codeframe --max-warnings 0",
    "lint:prettier": "prettier --write --experimental-cli --log-level warn '**/*.{ts,js,mjs}'",
    "test": "npm run test:integration:local && npm run test:import",
    "test:unit": "karma start ./test-unit/karma.conf.js --single-run",
    "test:unit:watch": "karma start ./test-unit/karma.conf.js --auto",
    "test:integration": "node ./test-integration/run.mjs './test-integration/**/*.spec.mjs'",
    "test:integration:local": "node ./test-integration/run-local.mjs './test-integration/**/*.spec.mjs'",
    "test:e2e": "NGROK_ENABLED=false CHROME_ONLY=true node ./test-integration/run.mjs './test-integration/encrypt/encrypt.spec.mjs'",
    "test:import:setup": "cd test-import && npm run setup",
    "test:import": "npm run test:import:setup && mocha './test-import/*.spec.mjs'",
    "test:bstack-sdk": "browserstack-node-sdk mocha",
    "ts:check": "tsc --noEmit --skipLibCheck",
    "np": "npm run dist && np",
    "version": "run-s clean build dist release # (note: auto-executed by np)",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": "prettier --write --experimental-cli"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@ngrok/ngrok": "1.7.0",
    "@rollup/plugin-commonjs": "29.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-replace": "6.0.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "12.3.0",
    "browserstack-local": "1.5.8",
    "browserstack-node-sdk": "1.49.0",
    "chai": "4.5.0",
    "chai-subset": "1.6.0",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "eslint": "9.39.2",
    "eslint-formatter-codeframe": "7.32.2",
    "express": "4.22.1",
    "glob": "13.0.0",
    "globals": "17.0.0",
    "husky": "9.1.7",
    "jquery": "3.7.1",
    "karma": "6.4.4",
    "karma-chai": "0.1.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-mocha": "2.0.1",
    "lint-staged": "16.2.7",
    "mingo": "6.3.4",
    "mocha": "11.7.1",
    "np": "11.2.0",
    "npm-run-all": "4.1.5",
    "on-finished": "2.4.1",
    "prettier": "3.8.0",
    "replace-in-file": "8.4.0",
    "rollup": "4.57.0",
    "rollup-plugin-dts": "6.4.1",
    "rollup-plugin-generate-package-json": "3.2.0",
    "rollup-plugin-license": "3.6.0",
    "selenium-webdriver": "4.39.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "xhook": "1.6.0",
    "yaml": "2.8.0"
  },
  "dependencies": {
    "detectincognitojs": "1.7.0"
  },
  "np": {
    "packageManager": "npm",
    "branch": "v2",
    "contents": "./dist"
  },
  "mocha": {
    "timeout": 10000
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "avoid",
    "bracketSameLine": true,
    "importOrderTypeScriptVersion": "5.0.0",
    "importOrder": [
      "<BUILTIN_MODULES>",
      "<THIRD_PARTY_MODULES>",
      "^[.].+$",
      "^[.]$"
    ],
    "plugins": [
      "@ianvs/prettier-plugin-sort-imports"
    ]
  },
  "engines": {
    "node": ">=22.x"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.16.0"
    }
  },
  "volta": {
    "node": "22.16.0"
  }
}
