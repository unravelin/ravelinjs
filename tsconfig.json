{
  "include": ["lib-ts/**/*"],
  "compileOnSave": false,
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "target": "esnext",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noImplicitThis": true
  },
  "exclude": [
    "build",
    "dist",
    "releases",
    "test-unit",
    "test-integration",
    "node_modules"
  ]
}
