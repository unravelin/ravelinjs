{
  "compileOnSave": false,
  "rootDir": ".",
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "lib": ["es2023", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noImplicitThis": true
  },
  "exclude": [
    "lib",
    "lib-ts",
    "node_modules"
  ]
}
