{
  "compileOnSave": false,
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "noImplicitThis": true
  },
  "exclude": [
    "src",
    "node_modules"
  ]
}
